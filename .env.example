TSEBISA_ENV=production
TSEBISA_SECRET_KEY=replace-with-a-random-secret
TSEBISA_ADMIN_PASSWORD=replace-with-a-unique-long-password
TSEBISA_DATA_DIR=/home/YOUR_USERNAME/TTsebisa-data
TSEBISA_STORAGE_BACKEND=sqlite
# For Neon, set TSEBISA_STORAGE_BACKEND=neon and provide the connection string privately:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
AT_USERNAME=sandbox
AT_API_KEY=replace-with-your-africas-talking-sandbox-api-key
AT_SMS_ENVIRONMENT=sandbox
# Optional, only use a sender ID already approved for your account/country.
# AT_SENDER_ID=YOUR_APPROVED_SENDER_ID
# Set a long random value and configure the SMS inbound callback URL as:
# https://YOUR_APP_HOST/api/sms/inbound?token=YOUR_PRIVATE_TOKEN
# SMS_INBOUND_TOKEN=replace-with-a-long-random-token
